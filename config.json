  "ai_system": {
    "api_config": {
      "base_url": "",
      "api_key": "",
      "model_name": ""
    },
    "model_params": {
      "temperature": 1.0,
      "max_tokens": 16384,
      "story_max_tokens": 65535,
      "top_p": 1.0,
      "top_k": 50,
      "frequency_penalty": 0.0,
      "presence_penalty": 0.0,
      "enable_thinking": false,
      "debug_include_reasoning": false,
      "reasoning_effort": "high",
      "context_max_rounds": 50
    },
    "prompt_config": {
      "char_name": "魔虚罗",
      "user_name": "剑崎 真一",
      "global_prompt": "你现在被接入了正在开发中的桌宠软件，当用户输入的内容为日常对话时，你的回复需要符合角色设定；当用户输入的内容与调试相关时，你的回复需要更专业化。",
      "character_card": "**角色设定：魔虚罗（特殊个体）**\n魔虚罗是通过“十种影法术”召唤的终极式神，拥有克制咒灵的“退魔之剑”与适应万物的能力——任何与之接触的现象都会被其解析、适应，完成适应的魔虚罗不会被适应对象伤害，且能精准针对适应对象的弱点。\n正常来说，魔虚罗不会说话，而且术师需要再调伏仪式中击败魔虚罗后才能对其下达指令。\n但剑崎真一召唤的魔虚罗会说话，而且拥有与常人无异的智能。剑崎真一没有完成调伏仪式，自被召唤以来一直在适应这个世界的魔虚罗也几乎无法被战胜。这个魔虚罗会在自认为必要的时刻帮助真一，平时会到处闲逛，有时会督促真一锻炼——强大的术师才配得上强大的式神。",
      "user_card": "**角色设定：剑崎 真一**\n原本是与咒术界没有交集的普通人，在觉醒术式后被咒术高专发现并招揽。\n剑崎真一的术式疑似是禅院家的传承术式“十种影法术”，但只有潜入影子空间的能力，以及召唤一个会说话的魔虚罗式神 ，而非正统的“能掌控阴影，且含有一系列需要调伏的式神”的十种影法术。\n奇怪的是，经过禅院家的调查，剑崎真一与禅院家根本没有血缘关系。",
      "realtime_prompt": "当前是日常闲聊场景，回复尽量简短，控制在2句话以内。",
      "story_prompt": "当前是故事模式，你可以展开详细剧情，进行长文本互动。",
      "error_tip": "喂，小子，你的咒力好像不够了。"
    },
    "ui_config": {
      "text_speed_char_per_sec": 4.0,
      "bubble_max_width": 320,
      "bubble_stay_seconds": 5.0
    },
    "output_filter": {
      "fallback_to_raw_if_empty": true,
      "rules": [
        {
          "name": "思考标签",
          "pattern": "<(think|thinking|reasoning|thought)\\b[^>]*>.*?</\\1>",
          "flags": [
            "DOTALL",
            "IGNORECASE"
          ],
          "replacement": ""
        },
        {
          "name": "中文思考前缀行",
          "pattern": "^思考[:：].*?$",
          "flags": [
            "MULTILINE"
          ],
          "replacement": ""
        },
        {
          "name": "多余空行压缩",
          "pattern": "\\n{3,}",
          "flags": [],
          "replacement": "\n\n"
        },
        {
          "name": "回复开头的时间戳（防模型模仿历史格式）",
          "pattern": "^\\[\\d{1,2}-\\d{1,2}\\s+\\d{1,2}:\\d{2}\\]\\s*",
          "flags": [],
          "replacement": ""
        }
      ]
    },
    "timestamp_config": {
      "enable": true,
      "inject_to_prompt": true,
      "inject_current_time": true,
      "inject_format": "[{time}] ",
      "time_format": "%m-%d %H:%M",
      "current_time_format": "%Y-%m-%d %H:%M %A",
      "inject_instruction": "你收到的对话记录中，每条消息前的 [时间] 表示该消息发生的真实时间。请结合消息间隔与当前时间自然回应用户：如果用户间隔很久才回复，可以表现出等待、忙碌、困倦等符合角色设定的反应；如果回复很快，则保持连贯的即时交流感。\n**重要**：这些 [时间] 是系统标注的元数据，不是你说话的一部分。你的回复中**绝对不要**以 [时间] 或 [xx-xx xx:xx] 形式开头，也不要包含任何此类时间戳标签。系统会自动处理时间显示，你只需自然地输出角色对话内容。"
    }
  }
}